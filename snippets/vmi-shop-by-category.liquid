{% comment %}
  vmi-shop-by-category.liquid
  Renders a vertical (up-down) hover dropdown mega menu for Shop By Category
{% endcomment %}

{% liquid
  assign block_settings = block.settings
  assign category_linklist = block_settings.category_menu
  if category_linklist == blank or category_linklist.links.size == 0
    assign category_linklist = linklists['main-menu']
  endif
%}

<div class="vmi-category-dropdown-wrapper">
  <a href="{{ routes.collections_url }}" class="vmi-category-dropdown-trigger" aria-haspopup="true">
    <span class="vmi-category-trigger-text">SHOP BY CATEGORY</span>
    <span class="svg-wrapper vmi-category-trigger-caret">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </a>

  {% if category_linklist.links.size > 0 %}
    <div class="vmi-category-mega-panel color-{{ settings.popover_color_scheme }}">
      <div class="vmi-category-mega-inner">
        <ul class="vmi-category-mega-list" role="list">
          {% for link in category_linklist.links %}
            <li class="vmi-category-mega-item">
              <a href="{{ link.url }}" class="vmi-category-vertical-link">
                {% if link.type == 'collection_link' and link.object.featured_image != blank %}
                  <span class="vmi-category-item-img">
                    <img
                      src="{{ link.object.featured_image | image_url: width: 60 }}"
                      alt="{{ link.title | escape }}"
                      width="26"
                      height="26"
                      loading="lazy"
                    >
                  </span>
                {% else %}
                  <span class="vmi-category-item-dot"></span>
                {% endif %}
                <span class="vmi-category-item-title">{{ link.title | escape }}</span>
                {% if link.links != blank %}
                  <span class="svg-wrapper vmi-category-arrow-right">
                    {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                  </span>
                {% endif %}
              </a>

              {% if link.links != blank %}
                <div class="vmi-category-sub-panel">
                  <ul class="vmi-category-sub-list" role="list">
                    {% for childlink in link.links %}
                      <li>
                        <a href="{{ childlink.url }}" class="vmi-category-sub-link">
                          {{ childlink.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .vmi-category-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .vmi-category-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: transparent;
    color: var(--color-foreground, #2d2d2d);
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: color 0.2s ease;
  }
  .vmi-category-trigger-text {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .vmi-category-trigger-caret {
   
    display: inline-flex;
    align-items: center;
    justify-content: center;

    transition: transform 0.2s ease;
  }
  .vmi-category-trigger-caret svg{
 width: 14px;
    height: 14px;
  color: var(--vmi-orange, #F48534);
  }

  .vmi-category-dropdown-wrapper:hover .vmi-category-trigger-caret {
    transform: rotate(180deg);
  }

  /* Vertical Up-to-Down Dropdown Panel */
  .vmi-category-mega-panel {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    z-index: 1000;
    min-width: 240px;
    width: max-content;
    background: #ffffff;
    border: 1px solid rgba(53, 51, 112, 0.12);
    border-radius: 14px;
    box-shadow: 0 14px 36px rgba(53, 51, 112, 0.14);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
  }

  /* Invisible hover bridge to prevent mouse cursor from losing hover state */
  .vmi-category-mega-panel::before {
    content: '';
    position: absolute;
    top: -16px;
    left: 0;
    width: 100%;
    height: 18px;
    background: transparent;
  }

  .vmi-category-dropdown-wrapper:hover .vmi-category-mega-panel,
  .vmi-category-mega-panel:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .vmi-category-mega-inner {
    padding: 8px 6px;
  }

  .vmi-category-mega-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vmi-category-mega-item {
    position: relative;
    width: 100%;
  }

  .vmi-category-vertical-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-radius: 8px;
    color: var(--vmi-indigo, #353370);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    border-left: 3px solid transparent;
    transition: all 0.18s ease;
  }

  .vmi-category-vertical-link:hover {
    background: #FAF8F3;
    color: var(--vmi-orange, #F48534);
    border-left-color: var(--vmi-orange, #F48534);
    padding-left: 18px;
  }

  .vmi-category-item-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--vmi-gold, #C8A86B);
    display: inline-block;
    flex-shrink: 0;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .vmi-category-vertical-link:hover .vmi-category-item-dot {
    background: var(--vmi-orange, #F48534);
    transform: scale(1.3);
  }

  .vmi-category-item-img img {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
  }

  .vmi-category-item-title {
    flex-grow: 1;
    line-height: 1.2;
  }

  .vmi-category-arrow-right {
    width: 12px;
    height: 12px;
    color: #a0a0a0;
  }

  .vmi-category-sub-panel {
    position: absolute;
    top: 0;
    left: 100%;
    margin-left: 4px;
    background: #ffffff;
    border: 1px solid rgba(53, 51, 112, 0.12);
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(53, 51, 112, 0.12);
    padding: 6px;
    display: none;
    min-width: 190px;
    z-index: 1001;
  }

  .vmi-category-mega-item:hover .vmi-category-sub-panel {
    display: block;
  }

  .vmi-category-sub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vmi-category-sub-link {
    display: block;
    padding: 8px 12px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--vmi-indigo, #353370);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .vmi-category-sub-link:hover {
    background: #FAF8F3;
    color: var(--vmi-orange, #F48534);
  }
</style>
