{%- doc -%}
  This snippet is used to render a product card.
{%- enddoc -%}

{{ 'best-sellers-products.css' | asset_url | stylesheet_tag }}

{% assign block_settings = block.settings %}

{% liquid
  assign tag_string = product.tags | join: ',' | downcase
  assign badge_text = ''
  assign badge_class = ''
  
  if tag_string contains 'bestseller' or tag_string contains 'best-seller'
    assign badge_text = 'BESTSELLER'
    assign badge_class = 'bestseller'
  elsif tag_string contains 'limited'
    assign badge_text = 'LIMITED'
    assign badge_class = 'limited'
  elsif tag_string contains 'sale' or product.compare_at_price > product.price
    assign badge_text = 'SALE'
    assign badge_class = 'sale'
  elsif tag_string contains 'new'
    assign badge_text = 'NEW'
    assign badge_class = 'new'
  elsif tag_string contains 'pre-order' or tag_string contains 'preorder'
    assign badge_text = 'PRE-ORDER'
    assign badge_class = 'pre-order'
  endif
  
  assign manhours_val = product.metafields.custom.manhours.value | default: product.metafields.custom.manhours
  
  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card size-style bsp-card"
  style="{% render 'size-style', settings: block_settings %}; border: none; background: transparent; padding: 0;"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  {%- unless onboarding -%}
    {% # theme-check-disable-next-line UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view', context: product_view_context | escape }}"
  {%- endunless -%}
>
  <a href="{{ product.url }}" class="bsp-image-container" style="display: block; position: relative;">
    <div class="flits-wishlist-button-container" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" style="position: absolute; top: 10px; right: 10px; z-index: 10;"></div>
    {% render 'wishlisthero-collection-product', product: product %}
    {%- if badge_text != blank -%}
      <div class="bsp-ribbon-badge {{ badge_class }}">{{ badge_text }}</div>
    {%- endif -%}

    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: class: 'bsp-product-image primary-image', loading: 'lazy', alt: product.title }}
      {%- if product.images[1] != blank -%}
        {{ product.images[1] | image_url: width: 800 | image_tag: class: 'bsp-product-image secondary-image', loading: 'lazy', alt: product.title }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'bsp-product-image' }}
    {%- endif -%}
  </a>

  <div class="bsp-info" style="padding-top: 16px; display: flex; flex-direction: column; flex-grow: 1;">
    {%- if manhours_val != blank -%}
      <div class="bsp-manhours-badge">Manhours: <strong>{{ manhours_val }}</strong></div>
    {%- else -%}
      <div class="bsp-manhours-badge">Manhours: <strong>450hrs</strong></div>
    {%- endif -%}

    <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
      <h3 class="bsp-product-title">{{ product.title }}</h3>
    </a>
    
    <p class="bsp-product-subtitle" style="margin-bottom: 5px;">
      {{ product.description | strip_html | truncate: 75 | default: 'Pure Silk Maharani Paithani · Maharani Pallu · Peacock Blue' }}
    </p>

    <div class="bsp-price-box" style="margin-top: auto;">
      <span class="bsp-price">{{ product.price | money_without_trailing_zeros }}</span>

      {%- if product.compare_at_price > product.price -%}
        <span class="bsp-compare-price">
          {{ product.compare_at_price | money_without_trailing_zeros }}
        </span>
        {%- assign savings_amount = product.compare_at_price | minus: product.price -%}
        {%- assign savings_percent = savings_amount | times: 100 | divided_by: product.compare_at_price -%}
        <span class="bsp-save-tag">Save {{ savings_percent }}%</span>
      {%- endif -%}
    </div>

    <div class="bsp-add-to-cart-wrapper" style="margin-top: 15px;">
      {%- if product.available -%}
        <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" on:submit="/handleSubmit">
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id -%}
          {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ product.variants.first.id }}" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" name="add" class="bsp-add-to-cart-btn" style="width: 100%; padding: 10px; background-color: #F7941E; color: #1E2447; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'" onclick="const btn = this; btn.innerText = 'Added'; setTimeout(() => { btn.innerText = 'Add to Cart'; }, 2000);">
              Add to Cart
            </button>
          {%- endform -%}
        </product-form-component>
      {%- else -%}
        <button type="button" class="bsp-add-to-cart-btn" disabled style="width: 100%; padding: 10px; background-color: #ccc; color: #666; border: none; border-radius: 4px; font-weight: bold; cursor: not-allowed;">Sold Out</button>
      {%- endif -%}
    </div>
  </div>
</product-card>
