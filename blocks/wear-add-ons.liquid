{%- assign add_ons = closest.product.metafields.custom.wear_add_on.value -%}
{%- if add_ons != blank -%}
  {{ 'wear-add-ons.css' | asset_url | stylesheet_tag }}
  <div class="wear-add-ons-container" data-wear-add-ons>
    <div class="wear-add-ons-header">
      Make it ready to wear
    </div>
    <div class="wear-add-ons-list">
      {%- for add_on_product in add_ons -%}
        {%- assign variant = add_on_product.selected_or_first_available_variant -%}
        <label class="wear-add-on-item" for="wear-add-on-{{ variant.id }}">
          <input 
            type="checkbox" 
            id="wear-add-on-{{ variant.id }}" 
            class="wear-add-on-checkbox"
            data-variant-id="{{ variant.id }}"
          >
          {%- if add_on_product.featured_image -%}
            <img class="wear-add-on-image" src="{{ add_on_product.featured_image | image_url: width: 100 }}" alt="{{ add_on_product.title | escape }}">
          {%- endif -%}
          <div class="wear-add-on-details">
            <h4 class="wear-add-on-title">{{ add_on_product.title }}</h4>
            <p class="wear-add-on-desc">{{ add_on_product.description | strip_html | truncatewords: 8 }}</p>
          </div>
          <div class="wear-add-on-price">
            {{ variant.price | money }}
          </div>
        </label>
      {%- endfor -%}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('[data-wear-add-ons]');
      if (!container) return;
      
      const form = container.closest('form') || document.querySelector('form[action*="/cart/add"]');
      if (!form) return;

      const checkboxes = container.querySelectorAll('.wear-add-on-checkbox');
      const acceleratedCheckout = form.querySelector('.accelerated-checkout-block');
      
      if (acceleratedCheckout && checkboxes.length > 0) {
        // Create an overlay to intercept clicks
        const overlay = document.createElement('div');
        overlay.style.position = 'absolute';
        overlay.style.top = '0';
        overlay.style.left = '0';
        overlay.style.width = '100%';
        overlay.style.height = '100%';
        overlay.style.zIndex = '10';
        overlay.style.cursor = 'pointer';
        overlay.style.display = 'none';
        
        // Ensure the container is positioned relative so the absolute overlay covers it
        acceleratedCheckout.style.position = 'relative';
        acceleratedCheckout.appendChild(overlay);

        const toggleOverlay = () => {
          const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
          if (anyChecked) {
            overlay.style.display = 'block';
          } else {
            overlay.style.display = 'none';
          }
        };

        checkboxes.forEach(cb => {
          cb.addEventListener('change', toggleOverlay);
        });
        
        toggleOverlay();

        overlay.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          // Show some loading state on the overlay if desired
          overlay.style.backgroundColor = 'rgba(255,255,255,0.5)';
          
          let items = [];
          
          // Main product
          const mainVariantInput = form.querySelector('[name="id"]');
          const mainQtyInput = form.querySelector('[name="quantity"]');
          if (mainVariantInput) {
            items.push({
              id: mainVariantInput.value,
              quantity: mainQtyInput ? parseInt(mainQtyInput.value) || 1 : 1
            });
          }
          
          // Add-ons
          const checkedAddOns = container.querySelectorAll('.wear-add-on-checkbox:checked');
          checkedAddOns.forEach(cb => {
            items.push({
              id: cb.dataset.variantId,
              quantity: 1
            });
          });
          
          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          })
          .then(response => response.json())
          .then(() => {
            window.location.href = window.Shopify.routes.root + 'checkout';
          })
          .catch(error => {
            console.error('Error adding to cart:', error);
            overlay.style.backgroundColor = 'transparent';
          });
        });
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Wear Add-ons",
  "settings": [],
  "presets": [
    {
      "name": "Wear Add-ons"
    }
  ]
}
{% endschema %}
