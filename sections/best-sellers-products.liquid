{{ 'best-sellers-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'best-sellers-products.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign selected_collection = section.settings.collection
  assign products_limit = section.settings.products_to_show | default: 4
  assign custom_product_blocks = section.blocks | where: 'type', 'custom_product'

  if selected_collection != blank
    if section.settings.sort_by == 'best-selling'
      assign collection_products = selected_collection.products | sort: 'best-selling'
    else
      assign collection_products = selected_collection.products
    endif
  endif
-%}

<div 
  id="BestSellers-{{ section.id }}" 
  class="best-sellers-section"
  data-section-type="best-sellers-products"
  style="
    --bsp-bg-color: {{ section.settings.background_color | default: '#ffffff' }};
    --bsp-mh-bg: {{ section.settings.manhours_bg_color | default: '#F7941E' }};
    --bsp-mh-color: {{ section.settings.manhours_text_color | default: '#1E2447' }};
  "
>
  <div class="vmi-container">
    <div class="bsp_title_view">
    <div class="bsp-header-bar">
      <div class="bsp-title-wrapper">
        <h2 class="section-title">{{ section.settings.heading | default: 'Best Sellers' }}</h2>
        <div class="bsp-divider"></div>
      </div>

      {%- if section.settings.show_view_all -%}
        {%- assign view_all_link = section.settings.view_all_url | default: selected_collection.url | default: '#' -%}
        <a href="{{ view_all_link }}" class="bsp-view-all">
          <span>{{ section.settings.view_all_text | default: 'View All' }}</span>
          <div class="bsp-view-all-icon">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
    <div class="bsp-grid">
      {%- if custom_product_blocks.size > 0 -%}
        {%- for block in custom_product_blocks limit: products_limit -%}
          {%- liquid
            assign product_title = block.settings.title | default: 'Chandrakor'
            assign product_url = block.settings.url | default: '#'
            assign badge_text = block.settings.badge_text
            assign badge_type = block.settings.badge_type | default: 'limited'
            assign category_text = block.settings.category | default: 'PAITHANI · YEOLA'
            assign subtitle_text = block.settings.subtitle | default: 'Pure Silk Maharani Paithani · Maharani Pallu · Peacock Blue'
            assign manhours_text = block.settings.manhours | default: '450hrs'
            assign price_text = block.settings.price | default: '₹28,560'
            assign compare_price_text = block.settings.compare_price | default: '₹32,436'
            assign save_text = block.settings.save_percentage | default: 'Save 12%'
            assign card_image = block.settings.image
          -%}

          <div class="bsp-card" {{ block.shopify_attributes }}>
            <a href="{{ product_url }}" class="bsp-image-container" style="display: block;">
              {%- if badge_text != blank -%}
                <div class="bsp-ribbon-badge {{ badge_type }}">{{ badge_text }}</div>
              {%- endif -%}

              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 800 | image_tag: class: 'bsp-product-image', loading: 'lazy', alt: product_title }}
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <img class="bsp-product-image" loading="lazy" src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=800&auto=format&fit=crop" alt="{{ product_title }}">
                  {%- when 2 -%}
                    <img class="bsp-product-image" loading="lazy" src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=800&auto=format&fit=crop" alt="{{ product_title }}">
                  {%- when 3 -%}
                    <img class="bsp-product-image" loading="lazy" src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=800&auto=format&fit=crop" alt="{{ product_title }}">
                  {%- when 4 -%}
                    <img class="bsp-product-image" loading="lazy" src="https://images.unsplash.com/photo-1609357605129-26f69add5d6e?q=80&w=800&auto=format&fit=crop" alt="{{ product_title }}">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'bsp-product-image' }}
                {%- endcase -%}
              {%- endif -%}
            </a>

            <div class="bsp-info">
              {%- if section.settings.show_category -%}
                <div class="bsp-category">{{ category_text }}</div>
              {%- endif -%}

              <a href="{{ product_url }}" style="text-decoration: none; color: inherit;">
                <h3 class="bsp-product-title">{{ product_title }}</h3>
              </a>

              {%- if subtitle_text != blank -%}
                <p class="bsp-product-subtitle">{{ subtitle_text }}</p>
              {%- endif -%}

              {%- if manhours_text != blank -%}
                <div class="bsp-manhours-badge">Manhours: <strong>{{ manhours_text }}</strong></div>
              {%- endif -%}

              <div class="bsp-price-box">
                <span class="bsp-price">{{ price_text }}</span>
                {%- if compare_price_text != blank -%}
                  <span class="bsp-compare-price">{{ compare_price_text }}</span>
                {%- endif -%}
                {%- if save_text != blank -%}
                  <span class="bsp-save-tag">{{ save_text }}</span>
                {%- endif -%}
              </div>

              <div class="bsp-add-to-cart-wrapper" style="margin-top: 15px;">
                <a href="{{ product_url }}" class="bsp-add-to-cart-btn" style="display: block; width: 100%; padding: 10px; background-color: #F7941E; color: #1E2447; text-align: center; text-decoration: none; border-radius: 4px; font-weight: bold; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">View Options</a>
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- elsif collection_products != blank and collection_products.size > 0 -%}
        {%- for product in collection_products limit: products_limit -%}
          {%- liquid
            assign savings_amount = product.compare_at_price | minus: product.price
            assign savings_percent = savings_amount | times: 100 | divided_by: product.compare_at_price
            assign manhours_val = product.metafields.custom.manhours.value | default: product.metafields.custom.manhours

            if section.settings.category_display_type == 'vendor'
              assign category_label = product.vendor
            elsif section.settings.category_display_type == 'collection'
              assign category_label = product.collections.first.title | default: selected_collection.title
            else
              assign category_label = 'PAITHANI · YEOLA'
            endif

            # Dynamic Product Tags Check
            assign badge_text = ''
            assign badge_class = ''
            
            assign tag_string = product.tags | join: ',' | downcase

            if tag_string contains 'bestseller' or tag_string contains 'best-seller'
              assign badge_text = 'BESTSELLER'
              assign badge_class = 'bestseller'
            elsif tag_string contains 'limited'
              assign badge_text = 'LIMITED'
              assign badge_class = 'limited'
            elsif tag_string contains 'sale' or product.compare_at_price > product.price
              assign badge_text = 'SALE'
              assign badge_class = 'sale'
            elsif tag_string contains 'new'
              assign badge_text = 'NEW'
              assign badge_class = 'new'
            elsif tag_string contains 'pre-order' or tag_string contains 'preorder'
              assign badge_text = 'PRE-ORDER'
              assign badge_class = 'pre-order'
            endif
          -%}
          <div class="bsp-card">
            <a href="{{ product.url }}" class="bsp-image-container" style="display: block;">
              {%- if badge_text != blank -%}
                <div class="bsp-ribbon-badge {{ badge_class }}">{{ badge_text }}</div>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: class: 'bsp-product-image', loading: 'lazy', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'bsp-product-image' }}
              {%- endif -%}
            </a>

            <div class="bsp-info">
              {%- if section.settings.show_category and category_label != blank -%}
                <div class="bsp-category">{{ category_label }}</div>
              {%- endif -%}

              <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
                <h3 class="bsp-product-title">{{ product.title }}</h3>
              </a>
              
              <p class="bsp-product-subtitle">
                {{ product.description | strip_html | truncate: 75 | default: 'Pure Silk Maharani Paithani · Maharani Pallu · Peacock Blue' }}
              </p>

              {%- if manhours_val != blank -%}
                <div class="bsp-manhours-badge">Manhours: <strong>{{ manhours_val }}</strong></div>
              {%- elsif block.settings.manhours != blank -%}
                <div class="bsp-manhours-badge">Manhours: <strong>{{ block.settings.manhours }}</strong></div>
              {%- else -%}
                <div class="bsp-manhours-badge">Manhours: <strong>450hrs</strong></div>
              {%- endif -%}

              <div class="bsp-price-box">
                <span class="bsp-price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="bsp-compare-price">{{ product.compare_at_price | money }}</span>
                  <span class="bsp-save-tag">Save {{ savings_percent }}%</span>
                {%- endif -%}
              </div>

              <div class="bsp-add-to-cart-wrapper" style="margin-top: 15px;">
                {%- if product.available -%}
                  <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" on:submit="/handleSubmit">
                    <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                    {%- assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id -%}
                    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" ref="variantId" value="{{ product.variants.first.id }}" />
                      <input type="hidden" name="quantity" value="1" />
                      <button type="submit" name="add" class="bsp-add-to-cart-btn" style="width: 100%; padding: 10px; background-color: #F7941E; color: #1E2447; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        Add to Cart
                      </button>
                    {%- endform -%}
                  </product-form-component>
                {%- else -%}
                  <button type="button" class="bsp-add-to-cart-btn" disabled style="width: 100%; padding: 10px; background-color: #ccc; color: #666; border: none; border-radius: 4px; font-weight: bold; cursor: not-allowed;">Sold Out</button>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Best Sellers Products",
  "class": "section-best-sellers-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
