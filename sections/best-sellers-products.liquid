      "label": "View All Custom Link (Overrides collection link)"
    }
  ],
  "blocks": [
    {
      "type": "custom_product",
      "name": "Custom Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
