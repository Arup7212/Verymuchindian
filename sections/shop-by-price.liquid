{{ 'shop-by-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-by-price.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign price_blocks = section.blocks | where: 'type', 'price_range'
-%}

<div
  id="ShopByPrice-{{ section.id }}"
  class="shop-by-price-section"
  data-section-type="shop-by-price"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  style="
    --sbp-bg-color: {{ section.settings.background_color | default: '#ffffff' }};
    --sbp-card-width: {{ section.settings.card_width | default: 180 }}px;
  "
>
  <div class="sbp-container">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="sbp-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="sbp-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="sbp-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <div class="sbp-divider"></div>
      </div>
    {%- endif -%}

    {%- if price_blocks.size > 0 -%}
      <div class="sbp-slider-wrapper">
        {%- if section.settings.show_arrows -%}
          <button class="sbp-nav-button prev" aria-label="Previous">
            <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          </button>
          <button class="sbp-nav-button next" aria-label="Next">
            <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </button>
        {%- endif -%}

        <div class="sbp-slider-viewport">
          <div class="sbp-slider-track">
            {%- for block in price_blocks -%}
              {%- liquid
                assign target_collection = block.settings.collection
                assign price_label = block.settings.price_label | default: '₹5K - 10K'
                assign card_url = block.settings.url | default: target_collection.url | default: '#'

                assign card_image = null
                if block.settings.image != blank
                  assign card_image = block.settings.image
                elsif target_collection != blank and target_collection.featured_image != blank
                  assign card_image = target_collection.featured_image
                endif
              -%}

              <div class="sbp-card-item" {{ block.shopify_attributes }}>
                <a href="{{ card_url }}" class="sbp-card">
                  <div class="sbp-card-image-wrapper">
                    {%- if card_image != blank -%}
                      {{ card_image | image_url: width: 500 | image_tag: class: 'sbp-card-image', loading: 'lazy', alt: price_label }}
                    {%- else -%}
                      {%- case forloop.index -%}
                        {%- when 1 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 2 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 3 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 4 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1609357605129-26f69add5d6e?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 5 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1610030469668-98e550d6193c?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 6 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- when 7 -%}
                          <img class="sbp-card-image" loading="lazy" src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=500&auto=format&fit=crop&crop=top" alt="{{ price_label }}">
                        {%- else -%}
                          {{ 'collection-1' | placeholder_svg_tag: 'sbp-card-image' }}
                      {%- endcase -%}
                    {%- endif -%}
                  </div>
                </a>
                <!-- Price label sits OUTSIDE/BELOW the image card as a white pill -->
                <div class="sbp-price-label">{{ price_label }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop By Price",
  "class": "section-shop-by-price",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "Shop By Price"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Text",
      "default": "India's Most Loved Artisanal Brand, Handcrafted By 17000+ Artisans"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto Slide Interval (Seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (Desktop px)",
      "min": 130,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "price_range",
      "name": "Price Range Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Overrides collection image)"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price Label Text",
          "default": "5K - 10K",
          "info": "e.g. 5K - 10K or ₹5,000 - ₹10,000"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link URL",
          "info": "Leave blank to use Shopify Collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Price",
      "settings": {
        "heading": "Shop By Price",
        "subtitle": "India's Most Loved Artisanal Brand, Handcrafted By 17000+ Artisans",
        "enable_autoplay": true,
        "autoplay_speed": 4,
        "card_width": 180,
        "show_arrows": true
      },
      "blocks": [
        { "type": "price_range", "settings": { "price_label": "5K - 10K" } },
        { "type": "price_range", "settings": { "price_label": "10K - 20K" } },
        { "type": "price_range", "settings": { "price_label": "20K - 30K" } },
        { "type": "price_range", "settings": { "price_label": "30K - 40K" } },
        { "type": "price_range", "settings": { "price_label": "40K - 50K" } },
        { "type": "price_range", "settings": { "price_label": "Premium" } },
        { "type": "price_range", "settings": { "price_label": "Luxury" } }
      ]
    }
  ]
}
{% endschema %}
