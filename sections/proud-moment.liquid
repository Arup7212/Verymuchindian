{{ 'proud-moment.css' | asset_url | stylesheet_tag }}
<script src="{{ 'proud-moment.js' | asset_url }}" defer="defer"></script>

<div
  id="ProudMoment-{{ section.id }}"
  class="proud-moment-section"
  data-section-type="proud-moment"
  style="--pm-bg-color: {{ section.settings.background_color | default: '#ffffff' }};"
>
  <div class="pm-container">

    <!-- ─── LEFT: Two Stacked Images ─── -->
    <div class="pm-images-col">
      <!-- Top Image (smaller) -->
      <div class="pm-image-wrap pm-img-top">
        {%- if section.settings.image_top != blank -%}
          {{ section.settings.image_top | image_url: width: 960 | image_tag: loading: 'lazy', alt: section.settings.image_top_alt | default: section.settings.heading_brand }}
        {%- else -%}
          <img loading="lazy" src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?q=80&w=960&auto=format&fit=crop" alt="Proud Moment Top" style="width:100%;height:100%;object-fit:cover;">
        {%- endif -%}
      </div>

      <!-- Bottom Image (taller / larger) -->
      <div class="pm-image-wrap pm-img-bottom">
        {%- if section.settings.image_bottom != blank -%}
          {{ section.settings.image_bottom | image_url: width: 960 | image_tag: loading: 'lazy', alt: section.settings.image_bottom_alt | default: section.settings.heading_brand }}
        {%- else -%}
          <img loading="lazy" src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=960&auto=format&fit=crop" alt="Proud Moment Bottom" style="width:100%;height:100%;object-fit:cover;">
        {%- endif -%}
      </div>
    </div>

    <!-- ─── RIGHT: Content ─── -->
    <div class="pm-content-col">

      <!-- Heading -->
      {%- if section.settings.heading_pre != blank -%}
        <p class="pm-heading-pre">{{ section.settings.heading_pre }}</p>
      {%- endif -%}

      <h2 class="pm-heading-main">
        <span class="pm-heading-brand">{{ section.settings.heading_brand }}</span>
        <span class="pm-heading-amp">&amp;</span>
      </h2>

      {%- if section.settings.heading_line2 != blank -%}
        <p class="pm-heading-line2">{{ section.settings.heading_line2 }}</p>
      {%- endif -%}

      <div class="pm-divider"></div>

      {%- if section.settings.description != blank -%}
        <p class="pm-description">{{ section.settings.description }}</p>
      {%- endif -%}

      <!-- Endorsement Card -->
      <div class="pm-endorsement-card">
        <div class="pm-endorsement-icon">
          <!-- Handshake Icon -->
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 36l6-6 10 4 12-10 8 2" stroke="#1a3a5c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 42c4 4 10 6 16 4l14-8c2-1 3-4 1-6-1-1-3-2-5-1l-6 3" stroke="#1a3a5c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 28l4 12" stroke="#1a3a5c" stroke-width="3" stroke-linecap="round"/>
            <path d="M46 18l6 8-6 4" stroke="#1a3a5c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="36" cy="18" r="4" stroke="#1a3a5c" stroke-width="3"/>
            <path d="M30 26c1-4 4-8 10-8" stroke="#1a3a5c" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="pm-endorsement-text">
          <span class="pm-endorsement-label">{{ section.settings.endorsement_label | default: 'Invested & Endorsed By' }}</span>
          <span class="pm-endorsement-name">{{ section.settings.endorsement_name | default: 'Namita Thapar' }}</span>
        </div>
      </div>

      <!-- Stats Card -->
      <div class="pm-stats-card">
        <!-- Stat 1: Rating -->
        <div class="pm-stat-item">
          <div class="pm-stat-icon">
            <!-- Star icon -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <span class="pm-stat-value">{{ section.settings.stat1_value | default: '4.9/5' }}</span>
          <span class="pm-stat-label">{{ section.settings.stat1_label | default: '40K+ Reviews' }}</span>
        </div>

        <!-- Stat 2: Customers -->
        <div class="pm-stat-item">
          <div class="pm-stat-icon">
            <!-- People/Group icon -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
          </div>
          <span class="pm-stat-value">{{ section.settings.stat2_value | default: '50K+' }}</span>
          <span class="pm-stat-label">{{ section.settings.stat2_label | default: 'Happy Customers' }}</span>
        </div>

        <!-- Stat 3: Authentic -->
        <div class="pm-stat-item">
          <div class="pm-stat-icon">
            <!-- Medal / Shield icon -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5zm-1 9h2v2h-2zm0-6h2v4h-2z"/>
            </svg>
          </div>
          <span class="pm-stat-value">{{ section.settings.stat3_value | default: '100%' }}</span>
          <span class="pm-stat-label">{{ section.settings.stat3_label | default: 'Authentic' }}</span>
        </div>
      </div>

      <!-- CTA Button -->
      {%- assign cta_url = section.settings.cta_url | default: '#' -%}
      {%- if section.settings.cta_collection != blank -%}
        {%- assign cta_url = section.settings.cta_collection.url -%}
      {%- endif -%}

      <a href="{{ cta_url }}" class="pm-cta-button">
        <span>{{ section.settings.cta_text | default: "Shop Namita's Curated Collection" }}</span>
        <div class="pm-cta-icon">
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </a>

    </div><!-- .pm-content-col -->
  </div><!-- .pm-container -->
</div>

{% schema %}
{
  "name": "Proud Moment",
  "class": "section-proud-moment",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top Image (Shark Tank / Event Photo)"
    },
    {
      "type": "text",
      "id": "image_top_alt",
      "label": "Top Image Alt Text",
      "default": "Shark Tank India - Very Much Indian"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom Image (Model / Collection Photo)"
    },
    {
      "type": "text",
      "id": "image_bottom_alt",
      "label": "Bottom Image Alt Text",
      "default": "Very Much Indian Saree Collection"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_pre",
      "label": "Heading Line 1 (Before brand)",
      "default": "Proud Moment For"
    },
    {
      "type": "text",
      "id": "heading_brand",
      "label": "Brand Name (Italic, Accent Color)",
      "default": "Very Much Indian"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 3 (After & symbol)",
      "default": "Traditional Weavers"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Very Much Indian was featured on for reviving the Shark Tank india heritage of Indian handlooms and empowering local weavers. Our journey is a tribute to the beauty of Indian craftsmanship, culture, and the timeless elegance of sarees cherished by millions of women."
    },
    {
      "type": "header",
      "content": "Endorsement Card"
    },
    {
      "type": "text",
      "id": "endorsement_label",
      "label": "Endorsement Label Text",
      "default": "Invested & Endorsed By"
    },
    {
      "type": "text",
      "id": "endorsement_name",
      "label": "Endorsed Person Name",
      "default": "Namita Thapar"
    },
    {
      "type": "header",
      "content": "Stats Card"
    },
    {
      "type": "text",
      "id": "stat1_value",
      "label": "Stat 1 Value",
      "default": "4.9/5"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "40K+ Reviews"
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Stat 2 Value",
      "default": "50K+"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Stat 3 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "Authentic"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Shop Namita's Curated Collection"
    },
    {
      "type": "collection",
      "id": "cta_collection",
      "label": "Button Collection Link",
      "info": "Select a collection to link to. Overrides the URL below."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Custom URL",
      "info": "Used if no collection is selected above."
    }
  ],
  "presets": [
    {
      "name": "Proud Moment",
      "settings": {
        "heading_pre": "Proud Moment For",
        "heading_brand": "Very Much Indian",
        "heading_line2": "Traditional Weavers",
        "description": "Very Much Indian was featured on for reviving the Shark Tank india heritage of Indian handlooms and empowering local weavers. Our journey is a tribute to the beauty of Indian craftsmanship, culture, and the timeless elegance of sarees cherished by millions of women.",
        "endorsement_label": "Invested & Endorsed By",
        "endorsement_name": "Namita Thapar",
        "stat1_value": "4.9/5",
        "stat1_label": "40K+ Reviews",
        "stat2_value": "50K+",
        "stat2_label": "Happy Customers",
        "stat3_value": "100%",
        "stat3_label": "Authentic",
        "cta_text": "Shop Namita's Curated Collection"
      }
    }
  ]
}
{% endschema %}
