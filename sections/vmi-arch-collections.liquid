<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,500;0,600&family=Cormorant+Garamond:ital,wght@0,400;0,500&family=Jost:wght@300;400;500;600&display=swap');

  .vmi-arch-collections {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 660px;
    background-image: var(--vmi-desktop-bg) !important;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 3.5rem 0 4rem;
    box-sizing: border-box;
  }

  .vmi-arch__bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(250, 248, 245, 0.45) 0%, rgba(242, 238, 232, 0.9) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* Mobile Dynamic Background Layer */
  .vmi-arch__mobile-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s ease, background-image 0.5s ease;
    pointer-events: none;
    display: none;
  }

  @media (max-width: 749px) {
    .vmi-arch-collections {
      background-image: none !important;
      background-color: #2D3742;
    }

    .vmi-arch__mobile-bg-layer {
      display: block;
      opacity: 0.65;
    }

    .vmi-arch__bg-overlay {
      background: linear-gradient(to bottom, rgba(30, 38, 46, 0.6) 0%, rgba(15, 20, 25, 0.88) 100%);
    }
  }

  .vmi-arch__container {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ════════════════════════════════
     HEADER LOGO & SUBTITLE
  ════════════════════════════════ */
  .vmi-arch__header {
    text-align: center;
    margin-bottom: 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vmi-arch__logo-brand {
    display: flex;
    align-items: baseline;
    line-height: 1;
  }

  .vmi-arch__first-letter {
    font-family: 'Pinyon Script', cursive;
    font-size: 4.8rem;
    line-height: 0.8;
    color: var(--vmi-text-color);
    margin-right: -0.06em;
  }

  .vmi-arch__rest-letters {
    font-family: 'Playfair Display', 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--vmi-text-color);
  }

  .vmi-arch__logo-img {
    max-width: 220px;
    height: auto;
    display: block;
  }

  .vmi-arch__subtitle {
    font-family: 'Jost', var(--vmi-font-body, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.38em;
    color: var(--vmi-text-color);
    opacity: 0.92;
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  /* ════════════════════════════════
     SLIDER TRACK & EXACT SVG LAYERING
  ════════════════════════════════ */
  .vmi-arch__slider-wrap {
    width: 100%;
    overflow: hidden;
  }

  .vmi-arch__track {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 3rem 4rem 3.5rem;
    box-sizing: border-box;
    scrollbar-width: none;
    cursor: grab;
  }

  .vmi-arch__track:active {
    cursor: grabbing;
  }

  .vmi-arch__track::-webkit-scrollbar {
    display: none;
  }

  /* ── CARD BASE CONTAINER ── */
  .vmi-arch-card {
    flex: 0 0 250px;
    scroll-snap-align: center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease;
    user-select: none;
    opacity: 0.88;
  }

  .vmi-arch-card__inner {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .vmi-arch-card__frame-box {
    position: relative;
    width: 100%;
    aspect-ratio: 965 / 1600;
  }

  /* Layer 2: Exact User Frame SVG Overlay */
  .vmi-arch-card__frame-svg {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 2;
  }

  .vmi-arch-frame-path {
    transition: opacity 0.4s ease;
  }

  .vmi-arch-frame-path--inactive {
    opacity: 1;
  }

  .vmi-arch-frame-path--active {
    opacity: 0;
  }

  /* Layer 3: Title & Diamond Symbol (Strictly Constrained Width inside Card Chin) */
  .vmi-arch-card__meta {
    position: absolute;
    top: 82.5%;
    bottom: 2%;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .vmi-arch-card__title-wrap {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.5rem;
    width: 125px;
    max-width: 125px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .vmi-arch-card__title-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(63, 74, 84, 0.28);
    transition: background-color 0.4s ease;
  }

  .vmi-arch-card__title-line--top {
    top: 0;
  }

  .vmi-arch-card__title-line--bottom {
    bottom: 0;
  }

  .vmi-arch-card__title {
    font-family: 'Jost', var(--vmi-font-body, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    color: #3F4A54;
    transition: color 0.4s ease;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vmi-arch-card__diamond {
    margin-top: 0.2rem;
    display: none;
  }

  .vmi-decorative-diamond-svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* ── ACTIVE CARD (CENTER FOCUSED CARD) ── */
  .vmi-arch-card.active {
    transform: scale(1.14);
    opacity: 1;
    z-index: 10;
  }

  .vmi-arch-card.active .vmi-arch-frame-path--inactive {
    opacity: 0;
  }

  .vmi-arch-card.active .vmi-arch-frame-path--active {
    opacity: 1;
  }

  .vmi-arch-card.active .vmi-arch-card__title {
    color: #FAF8F5;
  }

  .vmi-arch-card.active .vmi-arch-card__title-line {
    background: rgba(255, 255, 255, 0.38);
  }

  .vmi-arch-card.active .vmi-arch-card__diamond {
    display: block;
  }

  /* ════════════════════════════════
     RESPONSIVE
  ════════════════════════════════ */
  @media (max-width: 1024px) {
    .vmi-arch__track {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (max-width: 749px) {
    .vmi-arch-collections {
      min-height: 560px;
      padding: 2.5rem 0 3rem;
    }

    .vmi-arch__track {
      gap: 1.2rem;
      padding: 2rem 1.5rem 2.5rem;
    }

    .vmi-arch-card {
      flex: 0 0 220px;
    }

    .vmi-arch-card.active {
      transform: scale(1.08);
    }

    .vmi-arch__first-letter { font-size: 3.8rem; }
    .vmi-arch__rest-letters { font-size: 2.2rem; }
  }
</style>

<script>
  (function() {
    function initArchSlider() {
      const track = document.getElementById('vmi-arch-track-{{ section.id }}');
      const mobBgLayer = document.getElementById('vmi-arch-mob-bg-{{ section.id }}');
      if (!track) return;

      const cards = track.querySelectorAll('.vmi-arch-card');
      if (!cards.length) return;

      function updateActiveCard() {
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        let closestCard = null;
        let minDistance = Infinity;

        cards.forEach(card => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(trackCenter - cardCenter);
          if (distance < minDistance) {
            minDistance = distance;
            closestCard = card;
          }
        });

        if (closestCard) {
          cards.forEach(c => c.classList.remove('active'));
          closestCard.classList.add('active');

          if (window.innerWidth <= 749 && mobBgLayer) {
            const mobBgUrl = closestCard.getAttribute('data-mobile-bg');
            if (mobBgUrl) {
              mobBgLayer.style.backgroundImage = 'url("' + mobBgUrl + '")';
              mobBgLayer.style.opacity = '0.65';
            }
          }
        }
      }

      // Initial card centering on load
      const initialActiveCard = track.querySelector('.vmi-arch-card.active') || cards[Math.min(2, cards.length - 1)];
      if (initialActiveCard) {
        setTimeout(function() {
          const cardLeft = initialActiveCard.offsetLeft;
          const cardWidth = initialActiveCard.offsetWidth;
          const trackWidth = track.offsetWidth;
          track.scrollTo({
            left: cardLeft - (trackWidth / 2) + (cardWidth / 2),
            behavior: 'auto'
          });
          updateActiveCard();
        }, 100);
      } else {
        updateActiveCard();
      }

      track.addEventListener('scroll', function() {
        window.requestAnimationFrame(updateActiveCard);
      });

      // Drag to scroll
      let isDown = false;
      let startX;
      let scrollLeft;

      track.addEventListener('mousedown', function(e) {
        isDown = true;
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', function() { isDown = false; });
      track.addEventListener('mouseup', function() { isDown = false; });

      track.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });

      // Click card to center smoothly
      cards.forEach(card => {
        card.addEventListener('click', function() {
          const cardLeft = card.offsetLeft;
          const cardWidth = card.offsetWidth;
          const trackWidth = track.offsetWidth;
          track.scrollTo({
            left: cardLeft - (trackWidth / 2) + (cardWidth / 2),
            behavior: 'smooth'
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initArchSlider);
    } else {
      initArchSlider();
    }
  })();
</script>
{%- endif -%}

