{%- comment -%}
  VMI Arch Collections Section (sections/vmi-arch-collections.liquid)
  Luxury Indian Mughal Arch Collections Carousel
  - Desktop: 100% Static Background Banner (never changes)
  - Mobile: Dynamic background with rich warm light tone (opacity 0.75)
  - Image clipped strictly to SVG inner arch (zero black corners)
  - Active Card: White / Beige luxury fill (#FAF8F5 to #E8E1D2) with dark text (#2D3640) & exact diamond ornament
  - Inactive Cards: Slate / Grey fill (#4B5663 to #2D3640) with light text (#FAF8F5)
  - Interactive Carousel Pagination Dots at bottom
{%- endcomment -%}

{%- if section.settings.enable_section -%}
<section
  class="vmi-arch-collections vmi-section--full"
  id="vmi-arch-{{ section.id }}"
  style="
    {%- if section.settings.desktop_bg_image != blank -%}
      --vmi-desktop-bg: url('{{ section.settings.desktop_bg_image | image_url: width: 2200 }}');
    {%- else -%}
      --vmi-desktop-bg: url('{{ 'vmi-sangrah-bg-desktop.png' | asset_url }}');
    {%- endif -%}
    --vmi-text-color: {{ section.settings.text_color | default: '#401F28' }};
  "
>
  {%- comment -%} Mobile Dynamic Background Layer {%- endcomment -%}
  {%- assign initial_bg_url = 'vmi-sangrah-bg-desktop.png' | asset_url -%}
  {%- if section.settings.desktop_bg_image != blank -%}
    {%- assign initial_bg_url = section.settings.desktop_bg_image | image_url: width: 1400 -%}
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    {%- assign active_index = 2 -%}
    {%- if section.blocks.size < 3 -%}{%- assign active_index = 0 -%}{%- endif -%}
    {%- assign init_block = section.blocks[active_index] -%}
    {%- assign init_col = collections[init_block.settings.collection] -%}
    {%- if init_block.settings.mobile_bg_image != blank -%}
      {%- assign initial_bg_url = init_block.settings.mobile_bg_image | image_url: width: 1200 -%}
    {%- elsif init_col.featured_image != blank -%}
      {%- assign initial_bg_url = init_col.featured_image | image_url: width: 1200 -%}
    {%- elsif init_block.settings.image != blank -%}
      {%- assign initial_bg_url = init_block.settings.image | image_url: width: 1200 -%}
    {%- endif -%}
  {%- endif -%}
  <div class="vmi-arch__mobile-bg-layer" id="vmi-arch-mob-bg-{{ section.id }}" style="background-image: url('{{ initial_bg_url }}');"></div>
  <div class="vmi-arch__bg-overlay"></div>

  <div class="vmi-arch__container">
    
    {%- comment -%} Section Header: Sangrah Logo Calligraphy + COLLECTIONS Subtitle {%- endcomment -%}
    <div class="vmi-arch__header">
      <div class="vmi-arch__logo-brand">
        {%- if section.settings.logo_image != blank -%}
          <img
            src="{{ section.settings.logo_image | image_url: width: 400 }}"
            alt="{{ section.settings.heading | default: 'Sangrah' }}"
            class="vmi-arch__logo-img"
            style="max-width: {{ section.settings.logo_max_width | default: 220 }}px;"
          >
        {%- else -%}
          {%- assign heading_text = section.settings.heading | default: 'Sangrah' -%}
          {%- assign s_first_char = heading_text | slice: 0, 1 -%}
          {%- assign s_rest_chars = heading_text | slice: 1, 100 -%}
          <div class="vmi-arch__logo-text">
            <span class="vmi-arch__first-letter">{{ s_first_char }}</span>
            <span class="vmi-arch__rest-letters">{{ s_rest_chars }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="vmi-arch__subtitle">
        {{ section.settings.subtitle | default: 'COLLECTIONS' | upcase }}
      </div>
    </div>

    {%- comment -%} Arch Collection Cards — Swiper Carousel {%- endcomment -%}
    <div class="vmi-arch__slider-wrap">
      <div class="swiper vmi-arch-swiper" id="vmi-arch-swiper-{{ section.id }}">
        <div class="swiper-wrapper">

          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign col = collections[block.settings.collection] -%}
              {%- assign card_label = block.settings.label | default: col.title | default: 'COLLECTION' -%}
              {%- assign card_img = block.settings.image | default: col.featured_image -%}
              {%- assign mob_bg = block.settings.mobile_bg_image | default: col.featured_image | default: card_img -%}

              {%- assign mob_bg_url = '' -%}
              {%- if mob_bg != blank -%}
                {%- assign mob_bg_url = mob_bg | image_url: width: 1200 -%}
              {%- elsif section.settings.desktop_bg_image != blank -%}
                {%- assign mob_bg_url = section.settings.desktop_bg_image | image_url: width: 1400 -%}
              {%- else -%}
                {%- assign mob_bg_url = 'vmi-sangrah-bg-desktop.png' | asset_url -%}
              {%- endif -%}

              <div class="swiper-slide" data-index="{{ forloop.index0 }}" data-mobile-bg="{{ mob_bg_url }}" {{ block.shopify_attributes }}>
                <a href="{% if col != blank %}{{ col.url }}{% else %}#{% endif %}" class="vmi-arch-card__inner">
                  <div class="vmi-arch-card__frame-box">

                    {%- comment -%} Photo clipped to inner arch window via SVG clipPath {%- endcomment -%}
                    <svg class="vmi-arch-photo-svg" viewBox="0 0 400 720" preserveAspectRatio="none" aria-hidden="true">
                      <defs>
                        <clipPath id="archPhotoClip-{{ section.id }}-{{ block.id }}">
                          <path d="M199.403 29.3281C185.232 29.3281 171.199 31.047 158.105 34.3867C145.012 37.7264 133.116 42.622 123.095 48.793C113.074 54.9639 105.125 62.2898 99.7012 70.3525C98.1326 72.6845 96.7855 75.0656 95.6611 77.4824H65.3428C65.3425 99.9479 43.2887 118.429 31.5029 119.778H29.4297V436.198H43.6123C56.0512 439.438 74.2656 450.692 74.2656 477.669H95.6611C96.7854 480.086 98.1328 482.466 99.7012 484.798C105.125 492.861 113.074 500.186 123.095 506.357C133.116 512.528 145.012 517.424 158.105 520.764C171.199 524.103 185.232 525.822 199.403 525.822C213.575 525.822 227.608 524.103 240.701 520.764C253.794 517.424 265.691 512.528 275.712 506.357C285.733 500.186 293.682 492.861 299.105 484.798C300.674 482.466 302.021 480.086 303.146 477.669H324.043C324.397 465.566 331.3 441.644 355.397 436.198H370.583V119.778H369.716C341.532 116.708 331.732 90.3821 331.354 77.4824H303.146C302.021 75.0656 300.674 72.6845 299.105 70.3525C293.682 62.2898 285.733 54.9639 275.712 48.793C265.691 42.622 253.794 37.7264 240.701 34.3867C227.608 31.047 213.575 29.3281 199.403 29.3281Z" />
                        </clipPath>
                      </defs>
                      {%- if card_img != blank -%}
                        <image href="{{ card_img | image_url: width: 800 }}" x="0" y="0" width="400" height="720" clip-path="url(#archPhotoClip-{{ section.id }}-{{ block.id }})" preserveAspectRatio="xMidYMid slice" />
                      {%- else -%}
                        <image href="{{ 'vmi-sangrah-banarasi.png' | asset_url }}" x="0" y="0" width="400" height="720" clip-path="url(#archPhotoClip-{{ section.id }}-{{ block.id }})" preserveAspectRatio="xMidYMid slice" />
                      {%- endif -%}
                    </svg>

                    <img src="{{ 'vmi-arch-inactive.svg' | asset_url }}" class="vmi-arch-frame-img vmi-arch-frame-img--inactive" aria-hidden="true" />
                    <img src="{{ 'vmi-arch-active.svg' | asset_url }}" class="vmi-arch-frame-img vmi-arch-frame-img--active" aria-hidden="true" />

                    <div class="vmi-arch-card__meta">
                      <span class="vmi-arch-card__title">{{ card_label | upcase }}</span>
                      <div class="vmi-arch-card__flourish-wrap">
                        <svg width="100" height="10" viewBox="0 0 100 10" fill="none" class="vmi-arch-flourish-svg">
                          <line x1="0" y1="5" x2="38" y2="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.45"/>
                          <path d="M 50 1 C 47 4 44 5 41 5 C 44 5 47 6 50 9 C 53 6 56 5 59 5 C 56 5 53 4 50 1 Z" fill="currentColor" fill-opacity="0.65"/>
                          <circle cx="50" cy="5" r="1.2" fill="currentColor" fill-opacity="0.85"/>
                          <line x1="62" y1="5" x2="100" y2="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.45"/>
                        </svg>
                      </div>
                      <div class="vmi-arch-card__diamond" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 32 32" fill="none" class="vmi-decorative-diamond-svg">
                          <circle cx="16" cy="3" r="1.2" fill="#B83A38"/><circle cx="14.5" cy="4.8" r="0.9" fill="#B83A38"/><circle cx="17.5" cy="4.8" r="0.9" fill="#B83A38"/>
                          <circle cx="16" cy="29" r="1.2" fill="#B83A38"/><circle cx="14.5" cy="27.2" r="0.9" fill="#B83A38"/><circle cx="17.5" cy="27.2" r="0.9" fill="#B83A38"/>
                          <circle cx="3" cy="16" r="1.2" fill="#B83A38"/><circle cx="4.8" cy="14.5" r="0.9" fill="#B83A38"/><circle cx="4.8" cy="17.5" r="0.9" fill="#B83A38"/>
                          <circle cx="29" cy="16" r="1.2" fill="#B83A38"/><circle cx="27.2" cy="14.5" r="0.9" fill="#B83A38"/><circle cx="27.2" cy="17.5" r="0.9" fill="#B83A38"/>
                          <polygon points="16,6.5 25.5,16 16,25.5 6.5,16" fill="#1E252D" stroke="#D4AF37" stroke-width="0.8"/>
                          <polygon points="16,8.5 23.5,16 16,23.5 8.5,16" fill="#E6C462"/>
                          <polygon points="16,10 22,16 16,22 10,16" fill="none" stroke="#222B34" stroke-width="0.6" stroke-dasharray="1 1"/>
                          <polygon points="16,11.5 20.5,16 16,20.5 11.5,16" fill="#202730"/>
                          <polygon points="16,13 19,16 16,19 13,16" fill="#B83A38"/>
                          <circle cx="16" cy="16" r="0.8" fill="#FFFFFF"/>
                        </svg>
                      </div>
                    </div>

                  </div>
                </a>
              </div>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%} Default Demo Slides {%- endcomment -%}
            {%- assign demo_labels = 'AJRAK,AJRAK,BANARASI,KANJIVARAM,CHANDERI' | split: ',' -%}
            {%- assign demo_images = 'vmi-card-ajrakh.png,vmi-sangrah-ajrakh.png,vmi-sangrah-banarasi.png,vmi-card-kanjivaram.png,vmi-card-chanderi.png' | split: ',' -%}
            {%- for label in demo_labels -%}
              {%- assign img_file = demo_images[forloop.index0] -%}
              <div class="swiper-slide" data-index="{{ forloop.index0 }}" data-mobile-bg="{{ img_file | asset_url }}">
                <a href="#" class="vmi-arch-card__inner">
                  <div class="vmi-arch-card__frame-box">
                    <svg class="vmi-arch-photo-svg" viewBox="0 0 400 720" preserveAspectRatio="none" aria-hidden="true">
                      <defs>
                        <clipPath id="archPhotoClip-demo-{{ forloop.index }}">
                          <path d="M199.403 29.3281C185.232 29.3281 171.199 31.047 158.105 34.3867C145.012 37.7264 133.116 42.622 123.095 48.793C113.074 54.9639 105.125 62.2898 99.7012 70.3525C98.1326 72.6845 96.7855 75.0656 95.6611 77.4824H65.3428C65.3425 99.9479 43.2887 118.429 31.5029 119.778H29.4297V436.198H43.6123C56.0512 439.438 74.2656 450.692 74.2656 477.669H95.6611C96.7854 480.086 98.1328 482.466 99.7012 484.798C105.125 492.861 113.074 500.186 123.095 506.357C133.116 512.528 145.012 517.424 158.105 520.764C171.199 524.103 185.232 525.822 199.403 525.822C213.575 525.822 227.608 524.103 240.701 520.764C253.794 517.424 265.691 512.528 275.712 506.357C285.733 500.186 293.682 492.861 299.105 484.798C300.674 482.466 302.021 480.086 303.146 477.669H324.043C324.397 465.566 331.3 441.644 355.397 436.198H370.583V119.778H369.716C341.532 116.708 331.732 90.3821 331.354 77.4824H303.146C302.021 75.0656 300.674 72.6845 299.105 70.3525C293.682 62.2898 285.733 54.9639 275.712 48.793C265.691 42.622 253.794 37.7264 240.701 34.3867C227.608 31.047 213.575 29.3281 199.403 29.3281Z" />
                        </clipPath>
                      </defs>
                      <image href="{{ img_file | asset_url }}" x="0" y="0" width="400" height="720" clip-path="url(#archPhotoClip-demo-{{ forloop.index }})" preserveAspectRatio="xMidYMid slice" />
                    </svg>
                    <img src="{{ 'vmi-arch-inactive.svg' | asset_url }}" class="vmi-arch-frame-img vmi-arch-frame-img--inactive" aria-hidden="true" />
                    <img src="{{ 'vmi-arch-active.svg' | asset_url }}" class="vmi-arch-frame-img vmi-arch-frame-img--active" aria-hidden="true" />
                    <div class="vmi-arch-card__meta">
                      <span class="vmi-arch-card__title">{{ label }}</span>
                      <div class="vmi-arch-card__flourish-wrap">
                        <svg width="100" height="10" viewBox="0 0 100 10" fill="none" class="vmi-arch-flourish-svg">
                          <line x1="0" y1="5" x2="38" y2="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.45"/>
                          <path d="M 50 1 C 47 4 44 5 41 5 C 44 5 47 6 50 9 C 53 6 56 5 59 5 C 56 5 53 4 50 1 Z" fill="currentColor" fill-opacity="0.65"/>
                          <circle cx="50" cy="5" r="1.2" fill="currentColor" fill-opacity="0.85"/>
                          <line x1="62" y1="5" x2="100" y2="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.45"/>
                        </svg>
                      </div>
                      <div class="vmi-arch-card__diamond" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 32 32" fill="none" class="vmi-decorative-diamond-svg">
                          <circle cx="16" cy="3" r="1.2" fill="#B83A38"/><circle cx="14.5" cy="4.8" r="0.9" fill="#B83A38"/><circle cx="17.5" cy="4.8" r="0.9" fill="#B83A38"/>
                          <circle cx="16" cy="29" r="1.2" fill="#B83A38"/><circle cx="14.5" cy="27.2" r="0.9" fill="#B83A38"/><circle cx="17.5" cy="27.2" r="0.9" fill="#B83A38"/>
                          <circle cx="3" cy="16" r="1.2" fill="#B83A38"/><circle cx="4.8" cy="14.5" r="0.9" fill="#B83A38"/><circle cx="4.8" cy="17.5" r="0.9" fill="#B83A38"/>
                          <circle cx="29" cy="16" r="1.2" fill="#B83A38"/><circle cx="27.2" cy="14.5" r="0.9" fill="#B83A38"/><circle cx="27.2" cy="17.5" r="0.9" fill="#B83A38"/>
                          <polygon points="16,6.5 25.5,16 16,25.5 6.5,16" fill="#1E252D" stroke="#D4AF37" stroke-width="0.8"/>
                          <polygon points="16,8.5 23.5,16 16,23.5 8.5,16" fill="#E6C462"/>
                          <polygon points="16,10 22,16 16,22 10,16" fill="none" stroke="#222B34" stroke-width="0.6" stroke-dasharray="1 1"/>
                          <polygon points="16,11.5 20.5,16 16,20.5 11.5,16" fill="#202730"/>
                          <polygon points="16,13 19,16 16,19 13,16" fill="#B83A38"/>
                          <circle cx="16" cy="16" r="0.8" fill="#FFFFFF"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- endif -%}

        </div>

        {%- comment -%} Swiper Pagination (dots — mobile only via CSS) {%- endcomment -%}
        <div class="swiper-pagination vmi-arch-pagination" id="vmi-arch-dots-{{ section.id }}"></div>

      </div>
    </div>

  </div>
</section>



<style>
  .vmi-arch-collections {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 660px;
    background-image: var(--vmi-desktop-bg) !important;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 4.5rem 0;
    box-sizing: border-box;
  }

  .vmi-arch__bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(250, 248, 245, 0.45) 0%, rgba(242, 238, 232, 0.9) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* Mobile Dynamic Background Layer (Warm Sepia & Rich Texture Visibility) */
  .vmi-arch__mobile-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s ease, background-image 0.5s ease;
    pointer-events: none;
    display: none;
  }

  @media (max-width: 749px) {
    .vmi-arch-collections {
      background-image: none !important;
      background-color: #E8E1D5 !important;
    }

    .vmi-arch__mobile-bg-layer {
      display: block;
      opacity: 0.75;
    }

    .vmi-arch__bg-overlay {
      background: radial-gradient(circle at center, rgba(248, 244, 236, 0.25) 0%, rgba(225, 215, 200, 0.55) 100%);
    }
  }

  .vmi-arch__container {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ════════════════════════════════
     HEADER LOGO & SUBTITLE
  ════════════════════════════════ */
  .vmi-arch__header {
    text-align: center;
    margin-bottom: 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vmi-arch__logo-brand {
    display: flex;
    align-items: baseline;
    line-height: 1;
  }

  .vmi-arch__first-letter {
    font-family: 'Pinyon Script', cursive;
    font-size: 4.8rem;
    line-height: 0.8;
    color: var(--vmi-text-color);
    margin-right: -0.06em;
  }

  .vmi-arch__rest-letters {
    font-family: 'Playfair Display', 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--vmi-text-color);
  }

  .vmi-arch__logo-img {
    max-width: 220px;
    height: auto;
    display: block;
  }

  .vmi-arch__subtitle {
    font-family: 'Jost', var(--vmi-font-body, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.38em;
    color: var(--vmi-text-color);
    opacity: 0.92;
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  /* ════════════════════════════════
     SWIPER WRAPPER
  ════════════════════════════════ */
  .vmi-arch__slider-wrap {
    width: 100%;
    overflow: hidden;
  }

  .vmi-arch-swiper {
    width: 100%;
    padding: 3rem 0 2.5rem;
    overflow: visible !important;
  }

  .vmi-arch-swiper .swiper-wrapper {
    align-items: center;
  }

  /* ── SLIDE BASE CONTAINER (Inactive = Grey Fill) ── */
  .swiper-slide {
    width: 250px !important;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease;
    user-select: none;
    opacity: 0.88;
    cursor: pointer;
  }

  .vmi-arch-card__inner {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .vmi-arch-card__frame-box {
    position: relative;
    width: 100%;
    aspect-ratio: 400 / 720;
    overflow: hidden;
  }

  /* Photo SVG layer (clipped to inner arch shape) */
  .vmi-arch-photo-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* SVG Frame Image Overlay (sits on top of photo) */
  .vmi-arch-frame-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    z-index: 2;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .vmi-arch-frame-img--inactive {
    opacity: 1;
  }

  .vmi-arch-frame-img--active {
    opacity: 0;
  }


  .vmi-arch-card__meta {
    position: absolute;
    top: 77%;
    bottom: 5.5%;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    padding: 0 10px;
  }

  @media (max-width: 749px) {
    .vmi-arch-card__meta {
      top: 74%;
      bottom: 7%;
    }
  }

  /* Inactive Card: Light Text on Grey Fill */
  .vmi-arch-card__title {
    font-family: 'Jost', var(--vmi-font-body, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    color: #FAF8F5;
    transition: color 0.4s ease;
    margin: 0 0 0.15rem;
    white-space: nowrap;
  }

  .vmi-arch-card__flourish-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(250, 248, 245, 0.7);
    transition: color 0.4s ease;
    margin-top: 0.05rem;
  }

  .vmi-arch-flourish-svg {
    width: 90px;
    height: 9px;
    display: block;
  }

  .vmi-arch-card__diamond {
    margin-top: 0.25rem;
    display: none;
  }

  .vmi-decorative-diamond-svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* ── ACTIVE SLIDE (White / Luxury Beige Fill) ── */
  .swiper-slide.active {
    transform: scale(1.14);
    opacity: 1;
    z-index: 10;
  }

  .swiper-slide.active .vmi-arch-frame-img--inactive {
    opacity: 0;
  }

  .swiper-slide.active .vmi-arch-frame-img--active {
    opacity: 1;
  }

  /* Active Slide: Dark Text on White/Beige Fill */
  .swiper-slide.active .vmi-arch-card__title {
    color: #2D3640;
  }

  .swiper-slide.active .vmi-arch-card__flourish-wrap {
    color: #3F4A54;
  }

  .swiper-slide.active .vmi-arch-card__diamond {
    display: block;
  }

  /* ════════════════════════════════
     CAROUSEL PAGINATION DOTS (Swiper)
  ════════════════════════════════ */
  .vmi-arch-pagination {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    position: static !important;
    z-index: 5;
  }

  .vmi-arch__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(100, 85, 75, 0.35);
    cursor: pointer;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .vmi-arch__dot--active {
    background: #6A1B29 !important;
    transform: scale(1.3);
  }

  @media (max-width: 749px) {
    .vmi-arch-pagination {
      display: flex;
    }
  }

  /* ════════════════════════════════
     RESPONSIVE
  ════════════════════════════════ */
  @media (max-width: 749px) {
    .vmi-arch-collections {
      min-height: 560px;
      padding: 2.5rem 0 3rem;
    }

    .swiper-slide {
      width: 190px !important;
    }

    .swiper-slide.active {
      transform: scale(1.06);
    }

    .vmi-arch-card__meta {
      top: 80%;
      bottom: 2%;
    }

    .vmi-arch-card__title {
      font-size: 0.75rem;
    }

    .vmi-arch__first-letter { font-size: 3.4rem; }
    .vmi-arch__rest-letters { font-size: 2rem; }
  }

  @media (max-width: 480px) {
    .vmi-arch-collections {
      min-height: 480px;
      padding: 2rem 0 2.5rem;
    }

    .swiper-slide {
      width: 150px !important;
    }

    .swiper-slide.active {
      transform: scale(1.04);
    }

    .vmi-arch-card__title {
      font-size: 0.68rem;
      letter-spacing: 0.2em;
    }

    .vmi-arch__first-letter { font-size: 2.8rem; }
    .vmi-arch__rest-letters { font-size: 1.7rem; }
  }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  (function() {
    function initArchSwiper() {
      const swiperEl = document.getElementById('vmi-arch-swiper-{{ section.id }}');
      const mobBgLayer = document.getElementById('vmi-arch-mob-bg-{{ section.id }}');
      if (!swiperEl) return;

      function applyActiveState(swiper) {
        const slides = swiperEl.querySelectorAll('.swiper-slide');
        slides.forEach(slide => slide.classList.remove('active'));

        const activeSlide = swiperEl.querySelector('.swiper-slide-active');
        if (activeSlide) {
          activeSlide.classList.add('active');
          if (mobBgLayer) {
            const mobBgUrl = activeSlide.getAttribute('data-mobile-bg');
            if (mobBgUrl) {
              mobBgLayer.style.backgroundImage = 'url("' + mobBgUrl + '")';
              mobBgLayer.style.opacity = '0.75';
            }
          }
        }
      }

      const isMobile = window.innerWidth <= 749;

      const swiper = new Swiper(swiperEl, {
        loop: true,
        centeredSlides: true,
        slidesPerView: 'auto',
        spaceBetween: isMobile ? 18 : 28,
        speed: 600,
        grabCursor: true,
        touchRatio: 1.2,
        resistance: true,
        resistanceRatio: 0.85,
        pagination: {
          el: '.vmi-arch-pagination',
          clickable: true,
          bulletClass: 'vmi-arch__dot',
          bulletActiveClass: 'vmi-arch__dot--active',
          renderBullet: function(index, className) {
            return '<button type="button" class="' + className + '" aria-label="Slide ' + (index + 1) + '"></button>';
          }
        },
        on: {
          init: applyActiveState,
          slideChange: applyActiveState,
          loopFix: applyActiveState
        }
      });
    }

    function waitForSwiper(cb) {
      if (typeof Swiper !== 'undefined') { cb(); return; }
      var s = document.querySelector('script[src*="swiper"]');
      if (s) { s.addEventListener('load', cb); }
      else { document.addEventListener('DOMContentLoaded', cb); }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { waitForSwiper(initArchSwiper); });
    } else {
      waitForSwiper(initArchSwiper);
    }
  })();
</script>
{%- endif -%}

