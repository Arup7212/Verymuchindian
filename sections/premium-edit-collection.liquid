{{ 'premium-edit-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'premium-edit-collection.js' | asset_url }}" defer="defer"></script>

<div class="premium-edit-section" style="--premium-bg-color: {{ section.settings.background_color }};">
  <div class="vmi-container">
    
    <div class="premium-edit-header">
      {% if section.settings.title != blank %}
        <h2 class="section-title">
          {{ section.settings.title | replace: '[', '<span class="premium-gradient-text">' | replace: ']', '</span>' }}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="section-subtitle">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="premium-edit-grid">
      {%- assign collection = section.settings.collection -%}
      {%- assign max_products = section.settings.max_products -%}
      
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: max_products %}
          <div class="premium-product-card">
            
            <a href="{{ product.url }}" style="display: block; color: inherit; text-decoration: none;">
              <div class="premium-product-image-wrapper">
              {% if product.tags contains 'NEW' or product.tags contains 'new' or product.tags contains 'New' %}
                <span class="premium-product-badge premium-badge-new">NEW</span>
              {% elsif product.tags contains 'PRE-ORDER' or product.tags contains 'pre-order' or product.tags contains 'Pre-order' %}
                <span class="premium-product-badge premium-badge-preorder">PRE-ORDER</span>
              {% endif %}
              
              {% if product.featured_media != blank %}
                <img src="{{ product.featured_media | image_url: width: 600 }}"
                     alt="{{ product.featured_media.alt | escape }}"
                     loading="lazy"
                     width="{{ product.featured_media.width }}"
                     height="{{ product.featured_media.height }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="premium-product-details">
              {% if product.vendor != blank %}
                <div class="premium-product-vendor">{{ product.vendor }}</div>
              {% endif %}
              
              <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                <h3 class="premium-product-title">{{ product.title }}</h3>
              </a>
              
              {%- assign subtitle = product.metafields.custom.subtitle -%}
              {%- if subtitle == blank and product.description != blank -%}
                {%- assign subtitle = product.description | strip_html | truncate: 120 -%}
              {%- endif -%}
              {% if subtitle != blank %}
                <div class="premium-product-subtitle">{{ subtitle }}</div>
              {% endif %}
              
              {%- assign manhours = product.metafields.custom.manhours -%}
              {% if manhours != blank %}
                <div class="premium-product-manhours">Manhours: {{ manhours }}</div>
              {% endif %}
              
              <div class="premium-product-price">
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s> 
                {% endif %}
                {{ product.price | money }}
              </div>
              
              <div class="premium-add-to-cart-wrapper" style="margin-top: 15px; width: 100%;">
                {%- if product.available -%}
                  <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" on:submit="/handleSubmit">
                    <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                    {%- assign product_form_id = 'premium-product-form-' | append: section.id | append: '-' | append: product.id -%}
                    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" ref="variantId" value="{{ product.variants.first.id }}" />
                      <input type="hidden" name="quantity" value="1" />
                      <button type="submit" name="add" class="premium-add-to-cart-btn" style="width: 100%; padding: 10px; background-color: #F03B8D; color: #ffffff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        Add to Cart
                      </button>
                    {%- endform -%}
                  </product-form-component>
                {%- else -%}
                  <button type="button" class="premium-add-to-cart-btn" disabled style="width: 100%; padding: 10px; background-color: #ccc; color: #666; border: none; border-radius: 4px; font-weight: bold; cursor: not-allowed;">Sold Out</button>
                {%- endif -%}
              </div>
            </div>
            
          </div>
        {% endfor %}
      {% else %}
        {% if request.design_mode %}
          {%- for i in (1..max_products) -%}
            <div class="premium-product-card">
              <div class="premium-product-image-wrapper">
                {{ 'product-' | append: i | placeholder_svg_tag }}
              </div>
              <div class="premium-product-details">
                <div class="premium-product-vendor">Vendor Name</div>
                <h3 class="premium-product-title">Product Title</h3>
                <div class="premium-product-price">{{ 199900 | money }}</div>
              </div>
            </div>
          {%- endfor -%}
        {% endif %}
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Premium Edit Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Premium [Edit]",
      "info": "Use brackets [ ] for pink gradient highlight."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>All-over zari and hand-worked florals, woven only once you order. <br>₹75,000 to ₹2,50,000- reserved for the sarees that take the longest to make.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#282A4A"
    }
  ],
  "presets": [
    {
      "name": "Premium Edit Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}