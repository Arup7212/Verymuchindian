<div class="custom-collection-list-{{ section.id }}">
  {% if section.settings.title != blank %}
    <h2 class="section-title">{{ section.settings.title }}</h2>
  {% endif %}
  
  <div class="collection-grid">
    {% for block in section.blocks %}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- assign image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}
      {%- assign title = block.settings.title | default: collection.title -%}
      {%- assign link = collection.url -%}
      
      <div class="collection-item" {{ block.shopify_attributes }}>
        <a href="{{ link | default: '#' }}" class="collection-link">
          <div class="collection-image-wrapper">
            {% if image != blank %}
              <img src="{{ image | img_url: 'master' }}" alt="{{ title | escape }}" class="collection-image" loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="collection-text-wrapper">
            {% if title != blank %}
              <h3 class="collection-title">{{ title }}</h3>
            {% endif %}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .custom-collection-list-{{ section.id }} {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .custom-collection-list-{{ section.id }} .section-title {
    font-size: 28px;
    margin-bottom: 30px;
    color: #333;
    font-family: serif;
  }
  .custom-collection-list-{{ section.id }} .collection-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px; /* Adjust gap as needed */
  }
  .custom-collection-list-{{ section.id }} .collection-item {
    position: relative;
    overflow: hidden;
  }
  .custom-collection-list-{{ section.id }} .collection-link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }
  .custom-collection-list-{{ section.id }} .collection-image-wrapper {
    position: relative;
    padding-top: 150%; /* 2:3 aspect ratio like in the design */
    background-color: #f4f4f4; /* Placeholder background */
  }
  .custom-collection-list-{{ section.id }} .collection-image,
  .custom-collection-list-{{ section.id }} .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .custom-collection-list-{{ section.id }} .collection-text-wrapper {
    position: absolute;
    bottom: 30px;
    left: 0;
    width: 100%;
    text-align: center;
    z-index: 2;
  }
  .custom-collection-list-{{ section.id }} .collection-title {
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 1px 1px 4px rgba(0,0,0,0.6); /* To make text readable on bright images */
    letter-spacing: 1px;
  }

  /* Responsive Design */
  @media screen and (max-width: 768px) {
    .custom-collection-list-{{ section.id }} .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
  @media screen and (max-width: 480px) {
    .custom-collection-list-{{ section.id }} .collection-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Collection"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "header",
          "content": "Custom Overrides"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides the default collection image if selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Text",
          "info": "Overrides the default collection title if filled."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection List",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
