{{ 'festive-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'festive-collection.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection_card'
-%}

<div 
  id="FestiveCollection-{{ section.id }}" 
  class="festive-collection-section"
  data-section-type="festive-collection"
  style="--fc-bg-color: {{ section.settings.background_color | default: '#ffffff' }};"
>
  <div class="fc-container">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="fc-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="fc-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <p class="fc-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        
        <div class="fc-divider"></div>
      </div>
    {%- endif -%}

    {%- if collection_blocks.size > 0 -%}
      <div class="fc-grid">
        {%- for block in collection_blocks -%}
          {%- liquid
            assign target_collection = block.settings.collection
            assign tag_text = block.settings.tag_text | default: 'CLASSIC SILK PAITHANI'
            assign title_text = block.settings.title | default: target_collection.title | default: 'Festive'
            assign subtitle_text = block.settings.subtitle | default: 'Collection'
            assign button_text = block.settings.button_text | default: 'Shop Now'
            assign card_url = block.settings.url | default: target_collection.url | default: '#'
            
            assign card_image = null
            if block.settings.image != blank
              assign card_image = block.settings.image
            elsif target_collection != blank and target_collection.featured_image != blank
              assign card_image = target_collection.featured_image
            endif
          -%}

          <a href="{{ card_url }}" class="fc-card" {{ block.shopify_attributes }}>
            <div class="fc-image-wrapper">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 800 | image_tag: class: 'fc-image', loading: 'lazy', alt: title_text }}
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- when 2 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- when 3 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- when 4 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1609357605129-26f69add5d6e?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- when 5 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1610030469668-98e550d6193c?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- when 6 -%}
                    <img class="fc-image" loading="lazy" src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=800&auto=format&fit=crop" alt="{{ title_text }}">
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'fc-image' }}
                {%- endcase -%}
              {%- endif -%}
            </div>

            <!-- Exact Figma Fading Horizontal Glass Banner Bar -->
            <div class="fc-glass-bar">
              {%- if tag_text != blank -%}
                <div class="fc-bar-tag">{{ tag_text }}</div>
              {%- endif -%}
              <h3 class="fc-bar-title">{{ title_text }}</h3>
              {%- if subtitle_text != blank -%}
                <div class="fc-bar-subtitle">{{ subtitle_text }}</div>
              {%- endif -%}
            </div>

            <!-- Lower Position Hover State (Card 2 Design) -->
            <div class="fc-hover-overlay">
              {%- if tag_text != blank -%}
                <div class="fc-hover-tag">{{ tag_text }}</div>
              {%- endif -%}
              <h3 class="fc-hover-title">{{ title_text }}</h3>
              {%- if subtitle_text != blank -%}
                <div class="fc-hover-subtitle">{{ subtitle_text }}</div>
              {%- endif -%}
              
              <div class="fc-shop-button">
                <span>{{ button_text }}</span>
                <div class="fc-shop-button-icon">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

